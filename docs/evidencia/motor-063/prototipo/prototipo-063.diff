+// PROTOTIPO del brief 063 (scratchpad, no es código del repo). Constantes locales aquí para iterar; el
+// brief las pasa a limites.ts.
+import { ARENA } from "../sim/limites";
+import { prngDerivado } from "../sim/prng";
+import type { Lado, Posicion } from "../sim/tipos";
+import { transformar } from "./catalogo";
+import { distancia, enCancha, limitar, proyeccion } from "./geometria";
+import type { EntrenadorArena, EstadoArena, JugadorArena, PerfilJugador, Punto } from "./tipos";
+
+export const P = {
+  semilla: 0x61747231,
+  min: 20, max: 95, variacion: 12, distintivo: 12,
+  base: {
+    POR: { velocidad: 40, resistencia: 46, aguante: 38, entrada: 28, vision: 48, potencia: 50 },
+    DEF: { velocidad: 43, resistencia: 48, aguante: 44, entrada: 60, vision: 40, potencia: 38 },
+    MED: { velocidad: 46, resistencia: 56, aguante: 48, entrada: 48, vision: 56, potencia: 46 },
+    DEL: { velocidad: 56, resistencia: 42, aguante: 52, entrada: 30, vision: 44, potencia: 59 },
+  },
+  perfil: {
+    defensivo: { entrada: 8, potencia: -5, vision: -3 },
+    ofensivo: { velocidad: 7, potencia: 5, entrada: -7 },
+    pasador: { vision: 12, aguante: 3, velocidad: -4, potencia: -4 },
+    conductor: { aguante: 9, velocidad: 7, vision: -4 },
+    rematador: { potencia: 11, resistencia: -5, vision: -6 },
+    equilibrado: { resistencia: 5 },
+  } as Record<PerfilJugador, Partial<Record<Atributo, number>>>,
+  // efectos centrados en 50
+  velocidadMax: Number(process.env.K_VEL ?? 0.10), aceleracion: 0.15, resistenciaDesgaste: 0.35,
+  aguanteDuelo: Number(process.env.K_DUELO ?? 0.15), entradaDuelo: Number(process.env.K_DUELO ?? 0.15), visionError: 0.2, potenciaVelocidad: 0.08, aereoRadio: 0.3,
+  // persecución
+  repliegueRadioM: 30, repliegueMax: 4, repliegueAdelantoM: Number(process.env.ADELANTO ?? 4),
+  perseguirS: { DEL: 3, MED: 4, DEF: 6 }, perseguirMinS: 1.5, perseguirMaxS: 8,
+  limiteX: { DEL: ARENA.largoM / 2, MED: ARENA.largoM / 3, DEF: 0 },
+  // remate lejano
+  lejanoUmbral: 60, lejanoMaxM: 33, lejanoEspacioM: 5, lejanoLineaM: 2, lejanoProb: Number(process.env.P_LEJANO ?? 0.35), lejanoErrorPorM: Number(process.env.ERR_LEJ ?? 0.3), lejanoAltoPorM: Number(process.env.ALTO_LEJ ?? 0.03),
+  // pase largo
+  largoUmbral: Number(process.env.U_LARGO ?? 50), largoMaxM: 55, largoPenal: Number(process.env.P_LARGO ?? 0.7), largoAvanceMinM: 10, largoErrorM: 3, largoCaidaM: 5,
+};
+export const atributos = ["velocidad", "resistencia", "aguante", "entrada", "vision", "potencia"] as const;
+export type Atributo = (typeof atributos)[number];
+export type Atributos = Record<Atributo, number>;
+export const efecto = (a: number) => (a - 50) / 50;
+
+export function atributosDe(equipo: string, jugador: string, posicion: Posicion, perfil: PerfilJugador): Atributos {
+  const rng = prngDerivado(P.semilla, `atributos:arena-v6:${equipo}:${jugador}`);
+  const base = P.base[posicion], d = P.perfil[perfil];
+  const r = {} as Atributos;
+  for (const a of atributos) r[a] = base[a] + (d[a] ?? 0) + rng.int(-P.variacion, P.variacion);
+  const candidatos = posicion === "POR" ? ["velocidad", "vision"] as const : atributos;
+  r[rng.pick(candidatos)] += P.distintivo;
+  for (const a of atributos) r[a] = limitar(Math.round(r[a]), P.min, P.max);
+  return r;
+}
+
+export const estilosJuego = ["defensivo", "ofensivo", "posesion", "contragolpe", "directo", "presion"] as const;
+export type EstiloJuego = (typeof estilosJuego)[number];
+export const EFECTOS: Record<EstiloJuego, { bloqueM: number; persecucion: number; extra: number; repliegue: number; largo: number; lejano: number; umbralLargo: number; umbralLejano: number }> = {
+  defensivo: { bloqueM: -5, persecucion: 0.8, extra: 0, repliegue: 1, largo: 1.2, lejano: 0.8, umbralLargo: -5, umbralLejano: 5 },
+  ofensivo: { bloqueM: 3, persecucion: 1.15, extra: 0, repliegue: -1, largo: 1, lejano: 1.25, umbralLargo: 0, umbralLejano: -10 },
+  posesion: { bloqueM: 0, persecucion: 1.15, extra: 1, repliegue: 0, largo: 0.6, lejano: 0.8, umbralLargo: 20, umbralLejano: 10 },
+  contragolpe: { bloqueM: -3, persecucion: 0.9, extra: 0, repliegue: 1, largo: 1.5, lejano: 1, umbralLargo: -10, umbralLejano: 0 },
+  directo: { bloqueM: 0, persecucion: 1, extra: 0, repliegue: 0, largo: 1.5, lejano: 1.2, umbralLargo: -15, umbralLejano: -10 },
+  presion: { bloqueM: 5, persecucion: 1.3, extra: 1, repliegue: 0, largo: 1, lejano: 1, umbralLargo: 0, umbralLejano: 0 },
+};
+export function estiloJuegoDe(equipo: { nombre: string; estilo: string }, _e?: EntrenadorArena): EstiloJuego {
+  return prngDerivado(P.semilla, `estilo-juego:arena-v8:${equipo.nombre.normalize("NFC").trim().toLowerCase()}`).pick(estilosJuego);
+}
+
+export const lineaDePuesto = (p: string): "POR" | "DEF" | "MED" | "DEL" => p === "POR" ? "POR" : p.startsWith("DFC") || p === "LI" || p === "LD" || p.startsWith("CAR") ? "DEF" : p.startsWith("DC") || p === "EI" || p === "ED" ? "DEL" : "MED";
+
+/** Poseedor de campo más allá del último defensor de campo rival (x orientada del poseedor). */
+export function superado(estado: EstadoArena): JugadorArena | null {
+  const p = estado.jugadores.find(j => j.id === estado.balon.poseedor);
+  if (!p || p.puesto === "POR" || estado.balon.manos) return null;
+  const px = transformar(p.posicion, p.lado).x;
+  const defs = estado.jugadores.filter(j => j.lado !== p.lado && j.puesto !== "POR");
+  if (!defs.length) return null;
+  return px > Math.max(...defs.map(j => transformar(j.posicion, p.lado).x)) ? p : null;
+}
+export function destinoRepliegue(balon: Punto, lado: Lado): Punto {
+  const g = transformar({ x: 0, y: ARENA.anchoM / 2 }, lado);
+  const dx = g.x - balon.x, dy = g.y - balon.y, d = Math.hypot(dx, dy);
+  if (!d) return { ...g };
+  const k = Math.min(P.repliegueAdelantoM, d) / d;
+  return enCancha({ x: balon.x + dx * k, y: balon.y + dy * k });
+}
+export function limitarPersecucion(destino: Punto, j: JugadorArena): Punto {
+  const l = lineaDePuesto(j.puesto); if (l === "POR") return destino;
+  const o = transformar(destino, j.lado); o.x = Math.max(o.x, P.limiteX[l]);
+  return transformar(o, j.lado);
+}
+
+/** Candidato de remate lejano (sin PRNG). */
+export function puedeRematarLejos(j: JugadorArena, estado: EstadoArena, estilo?: EstiloJuego): boolean {
+  const a = j.atributos; if (!a || j.puesto === "POR" || a.potencia < P.lejanoUmbral + (estilo ? EFECTOS[estilo].umbralLejano : 0)) return false;
+  const o = transformar(j.posicion, j.lado), arco = { x: ARENA.largoM, y: ARENA.anchoM / 2 };
+  const d = distancia(o, arco);
+  if (d <= ARENA.radioTiroM || d > P.lejanoMaxM || Math.abs(o.y - ARENA.anchoM / 2) > ARENA.areaAnchoM / 2) return false;
+  const rivales = estado.jugadores.filter(r => r.lado !== j.lado);
+  if (rivales.some(r => distancia(r.posicion, j.posicion) < P.lejanoEspacioM)) return false;
+  const g = transformar(arco, j.lado);
+  return !rivales.filter(r => r.puesto !== "POR").some(r => proyeccion(r.posicion, j.posicion, g).distancia < P.lejanoLineaM);
+}
+
+/** Pase largo: receptor a (paseMaxM, alcance(vision)] con avance y ventaja en la caída. */
+export function opcionPaseLargo(j: JugadorArena, estado: EstadoArena, estilo: EstiloJuego | undefined): { receptor: JugadorArena; destino: Punto; puntuacion: number } | undefined {
+  const umbral = P.largoUmbral + (estilo ? EFECTOS[estilo].umbralLargo : 0);
+  const a = j.atributos; if (!a || j.puesto === "POR" || a.vision < umbral) return undefined;
+  const alcance = ARENA.paseMaxM + (P.largoMaxM - ARENA.paseMaxM) * Math.min(1, (a.vision - umbral) / (100 - P.largoUmbral));
+  const o = transformar(j.posicion, j.lado);
+  const rivales = estado.jugadores.filter(r => r.lado !== j.lado && r.puesto !== "POR");
+  let mejor: { receptor: JugadorArena; destino: Punto; puntuacion: number } | undefined;
+  for (const r of estado.jugadores.filter(p => p.lado === j.lado && p.id !== j.id && p.puesto !== "POR")) {
+    const d = distancia(j.posicion, r.posicion);
+    if (d <= ARENA.paseMaxM || d > alcance) continue;
+    const ro = transformar(r.posicion, j.lado), avance = ro.x - o.x;
+    const cambio = Math.abs(ro.y - o.y) >= ARENA.anchoM * 0.4;
+    if (avance < P.largoAvanceMinM && !cambio) continue;
+    const viaje = d / ARENA.velocidadBalonMps;
+    const destino = enCancha({ x: r.posicion.x + r.velocidad.x * viaje, y: r.posicion.y + r.velocidad.y * viaje });
+    const ventaja = Math.min(...rivales.map(x => distancia(x.posicion, destino))) - distancia(r.posicion, destino);
+    if (ventaja <= 0) continue;
+    const puntuacion = avance + Math.min(ventaja, ARENA.margenUtilM) - d * ARENA.pesoDistanciaPase * P.largoPenal / (estilo ? EFECTOS[estilo].largo : 1);
+    if (!mejor || puntuacion > mejor.puntuacion) mejor = { receptor: r, destino, puntuacion };
+  }
+  return mejor;
+}
