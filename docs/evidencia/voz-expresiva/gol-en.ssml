<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xmlns:mstts="https://www.w3.org/2001/mstts" xml:lang="en-US"><voice name="en-US-JennyNeural"><s><mstts:express-as style="excited" styledegree="1.21"><prosody rate="+12.6%" pitch="+6.6%" volume="+12.5%">Joel Mendiuz (3) shoots towards the opposing goal.</prosody></mstts:express-as><break time="140ms"/></s><s><mstts:express-as style="excited" styledegree="1.74"><prosody rate="+12.3%" pitch="+6.5%" volume="+13.2%">Goal! Joel Mendiuz scores!</prosody></mstts:express-as><break time="380ms"/></s></voice></speak>