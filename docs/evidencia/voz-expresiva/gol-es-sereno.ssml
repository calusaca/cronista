<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xmlns:mstts="https://www.w3.org/2001/mstts" xml:lang="es-MX"><voice name="es-MX-JorgeNeural"><s><prosody rate="+1.0%" pitch="+0.5%" volume="+0.0%">Joel Mendiuz (3) remata hacia la portería rival.</prosody><break time="140ms"/></s><s><prosody rate="+0.0%" pitch="+0.0%" volume="+0.0%">¡Gol! ¡Lo anota Joel Mendiuz!</prosody><break time="125ms"/></s></voice></speak>