{
  "name": "cronista",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts --reporter=verbose",
    "test:stats": "vitest run --config vitest.stats.config.ts --reporter=verbose --silent=false",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/sim/cli.ts",
    "arena": "node --import tsx src/arena/cli.ts",
    "arena:eval": "node --import tsx src/arena/eval-cli.ts",
    "arena:agente": "node --import tsx src/arena/agente-cli.ts",
    "arena:lote": "node --import tsx src/arena/lote-cli.ts",
    "arena:voz-muestras": "node --import tsx src/arena/voz-muestras-cli.ts",
    "arena:smoke-modelos": "node --import tsx src/arena/smoke-modelos-cli.ts",
    "arena:torneo": "node --import tsx src/arena/torneo-cli.ts",
    "azure:servicios": "node scripts/prepare-azure-services.mjs",
    "azure:lotes": "node scripts/deploy-azure-jobs.mjs",
    "azure:arena": "node scripts/deploy-azure-arena.mjs",
    "analizar": "tsx src/analista/cli.ts",
    "cronica": "tsx src/cadena/cli.ts",
    "presets": "tsx src/vista/cli-presets.ts",
    "eval": "tsx src/eval/cli.ts",
    "dataset": "tsx src/dataset/cli.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "e2e": "playwright test",
    "package:standalone": "node scripts/prepare-standalone.mjs",
    "test:deploy": "node --test scripts/*.test.mjs",
    "deploy:azure": "node scripts/deploy-azure.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "capture:demo": "node scripts/capture-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.5.2",
    "@azure/ai-projects": "^2.8.0",
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@microsoft/opentelemetry": "^1.5.0",
    "@opentelemetry/api": "^1.9.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  }
}
