# Variables de entorno de CRONISTA. Copiá este archivo a `.env` (ignorado por git)
# y completá los valores. NUNCA subas `.env` ni pegues una clave en el repo.

# Qué LLM usa la cadena: stub (por defecto, offline, $0) | foundry | azure-openai | foundry-modelos
CRONISTA_LLM=

# Microsoft Foundry (solo con CRONISTA_LLM=foundry)
# Clave del recurso Foundry (Portal de Azure → recurso → Keys and Endpoint).
FOUNDRY_API_KEY=
# Endpoint Anthropic del recurso, p. ej. https://<recurso>.services.ai.azure.com/anthropic
FOUNDRY_BASE_URL=
# Nombre del DEPLOYMENT (no del modelo), p. ej. claude-sonnet-5 o claude-haiku-4-5
FOUNDRY_DEPLOYMENT=

# Azure OpenAI (solo con CRONISTA_LLM=azure-openai; brief 023, bake-off del 6 oct)
# Endpoint del recurso, p. ej. https://<recurso>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Clave del recurso (Portal de Azure → recurso → Keys and Endpoint). Va en la cabecera api-key.
AZURE_OPENAI_API_KEY=
# Nombre del DEPLOYMENT (no del modelo), p. ej. gpt-6.1-sol
AZURE_OPENAI_DEPLOYMENT=
# Opcional: api-version de chat completions. Vacía ⇒ el default de src/lib/llm-azure-openai.ts
# (API_VERSION_AZURE_OPENAI).
AZURE_OPENAI_API_VERSION=
# GPT-6.1 Sol requiere razonamiento: usar low para la primera prueba.
# Valores: low | medium | high | xhigh | max. Vacía ⇒ parámetros clásicos con temperature.
# Con razonamiento: sin temperature; techo de 16.000 tokens (razonamiento + respuesta).
AZURE_OPENAI_REASONING_EFFORT=

# Foundry Models (otras familias; solo con CRONISTA_LLM=foundry-modelos; brief 052)
# Host de Foundry del MISMO recurso: https://<recurso>.services.ai.azure.com (sin /anthropic).
# Ruta usada: /models/chat/completions (Azure AI Model Inference API).
FOUNDRY_MODELOS_ENDPOINT=
# Clave del recurso: es la misma que AZURE_OPENAI_API_KEY (Keys and Endpoint). Cabecera api-key.
FOUNDRY_MODELOS_API_KEY=
# Nombre del DEPLOYMENT (no del modelo), p. ej. cronista-grok. Va en el campo `model`.
FOUNDRY_MODELOS_DEPLOYMENT=
# json_schema | json_object | texto (por defecto json_object). Usar el que eligió la sonda
# de npm run arena:smoke-modelos; con texto se extrae el objeto JSON de la respuesta.
FOUNDRY_MODELOS_FORMATO_JSON=
# Opcional: api-version. Vacía ⇒ API_VERSION_FOUNDRY_MODELOS de src/lib/llm-foundry-modelos.ts.
FOUNDRY_MODELOS_API_VERSION=
# En la arena, por prefijo de catálogo: ARENA_<ID>_LLM=foundry-modelos y
# ARENA_<ID>_FOUNDRY_MODELOS_{ENDPOINT,API_KEY,DEPLOYMENT,FORMATO_JSON}.

# Directorio de la caché de crónicas (por defecto .cache/cronicas)
CRONISTA_CACHE_DIR=

# Brief 064 D3 · Raíz del sitio. Vacía ⇒ `/` redirige (307) a la arena y la crónica destacada vive en /cronicas.
# `cronicas` ⇒ `/` muestra la crónica destacada (host de la demo de crónicas, enlaces ya entregados).
CRONISTA_RAIZ=

# Arena en vivo: habilitar inferencia web de forma explícita. Sin esta opción,
# la demostración programada y los registros siguen disponibles sin inferencia.
ARENA_WEB_LLM=0
ARENA_NARRADOR_LLM=0
# Opcional: ID del catálogo usado por el narrador; independiente de los equipos.
ARENA_NARRADOR_MODELO=
# Catálogo opcional. Los prefijos sobreescriben las variables globales en el servidor.
# ARENA_MODELOS=[{"id":"equilibrado","nombre":"GPT-5.6 Luna","prefijo":"ARENA_EQUILIBRADO_"},{"id":"rapido","nombre":"GPT-5.4 mini","prefijo":"ARENA_RAPIDO_"}]
# ARENA_EQUILIBRADO_LLM=azure-openai
# ARENA_EQUILIBRADO_AZURE_OPENAI_DEPLOYMENT=cronista-equilibrado
# ARENA_EQUILIBRADO_AZURE_OPENAI_REASONING_EFFORT=low
# ARENA_RAPIDO_LLM=azure-openai
# ARENA_RAPIDO_AZURE_OPENAI_DEPLOYMENT=cronista-rapido
# ARENA_RAPIDO_AZURE_OPENAI_REASONING_EFFORT=low
# Para usar el catálogo anterior también para comentarios: ARENA_NARRADOR_MODELO=rapido
# Directorio de diarios y registros; montar almacenamiento persistente al desplegar.
ARENA_SESIONES_DIR=.cache/arena-sesiones
# Evaluación Foundry: autenticación de desarrollo mediante la sesión Azure CLI.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Servicios opcionales. Todo se habilita exclusivamente en el servidor.
# Sin Blob se conserva el adaptador local de una réplica.
ARENA_BLOB_ENDPOINT=
ARENA_BLOB_CONTENEDOR=arena
ARENA_ANALISTA_LLM=0
ARENA_AGENTE_NOMBRE=cronista-analista
ARENA_AGENTE_VERSION=
ARENA_AGENTE_MODELO=cronista-rapido
ARENA_VOZ=0
# Voces con estilos admitidos. Cambiar la voz genera una clave de caché distinta.
ARENA_VOZ_ES=es-MX-JorgeNeural
ARENA_VOZ_EN=en-US-JennyNeural
# Subdominio del recurso Speech/Foundry, sin /tts al final.
AZURE_SPEECH_ENDPOINT=
# Opcional: la clave de ese recurso. Si es el mismo de OpenAI se hereda su clave.
AZURE_SPEECH_KEY=
# Con Entra y sin clave: resource ID del recurso Speech.
AZURE_SPEECH_RESOURCE_ID=
# Azure Monitor: spans explícitos, sin capturar prompts ni credenciales.
CRONISTA_TELEMETRIA=0
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=cronista
# Container Apps y Jobs: client ID de la identidad asignada.
AZURE_CLIENT_ID=
