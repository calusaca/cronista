# Variables de entorno de CRONISTA. Copiá este archivo a `.env` (ignorado por git)
# y completá los valores. NUNCA subas `.env` ni pegues una clave en el repo.

# Qué LLM usa la cadena: stub (por defecto, offline, $0) | foundry | azure-openai
CRONISTA_LLM=

# Microsoft Foundry (solo con CRONISTA_LLM=foundry)
# Clave del recurso Foundry (Portal de Azure → recurso → Keys and Endpoint).
FOUNDRY_API_KEY=
# Endpoint Anthropic del recurso, p. ej. https://<recurso>.services.ai.azure.com/anthropic
FOUNDRY_BASE_URL=
# Nombre del DEPLOYMENT (no del modelo), p. ej. claude-sonnet-5 o claude-haiku-4-5
FOUNDRY_DEPLOYMENT=

# Azure OpenAI (solo con CRONISTA_LLM=azure-openai; brief 023, bake-off del 6 oct)
# Endpoint del recurso, p. ej. https://<recurso>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Clave del recurso (Portal de Azure → recurso → Keys and Endpoint). Va en la cabecera api-key.
AZURE_OPENAI_API_KEY=
# Nombre del DEPLOYMENT (no del modelo), p. ej. gpt-6.1-sol
AZURE_OPENAI_DEPLOYMENT=
# Opcional: api-version de chat completions. Vacía ⇒ el default de src/lib/llm-azure-openai.ts
# (API_VERSION_AZURE_OPENAI).
AZURE_OPENAI_API_VERSION=

# Directorio de la caché de crónicas (por defecto .cache/cronicas)
CRONISTA_CACHE_DIR=
